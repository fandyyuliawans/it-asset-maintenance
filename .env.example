# ==============================================================================
# IT ASSET MANAGEMENT & MAINTENANCE SYSTEM — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in real values before production use.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# 1. Public Google OAuth Client ID (Safe for browser; used by Google Identity Services)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"

# 2. Server-Side Google OAuth Client Secret (Optional if using ID token verification only)
GOOGLE_OAUTH_CLIENT_SECRET="SERVER_SIDE_ONLY_IF_REQUIRED"

# 2b. PostgreSQL Database Connection URL (Recommended for ultra-fast <20ms queries)
# Local example: postgresql://postgres:password@localhost:5432/it_asset_maintenance
# Cloud example (Supabase/Neon): postgresql://user:pass@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="YOUR_POSTGRESQL_CONNECTION_STRING"

# 3. Google Apps Script Web App Deployment URL (Used for Google Drive Photo Uploads or Sheets Fallback)
# Obtain from: Apps Script Editor -> Deploy -> Manage deployments -> Web app URL
GAS_WEB_APP_URL="YOUR_APPS_SCRIPT_WEB_APP_URL"

# 4. Shared Secret between Next.js Server and Google Apps Script
# Generate with: openssl rand -hex 32 (Must match GAS Script Property GAS_SHARED_SECRET)
GAS_SHARED_SECRET="SERVER_SIDE_SECRET_NOT_FOR_BROWSER"

# 5. Session Signing Secret (HMAC-SHA256 for HTTP-Only session cookies)
# Generate with: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SESSION_SECRET"

# 6. Application Base URL (Used for QR code payload links and OAuth redirects)
APP_BASE_URL="http://localhost:3000"

# 7. Access Control & Domain Restrictions
# Comma-separated Workspace domain(s) allowed to sign in via Google SSO
ALLOWED_EMAIL_DOMAIN="your-hotel-domain.com"

# Comma-separated email allowlist for initial Admin bootstrap or external technicians
INITIAL_ADMIN_EMAILS="it.admin@your-hotel-domain.com"
ALLOWED_EMAIL_ALLOWLIST=""

# 8. Upload Constraints
MAX_UPLOAD_SIZE_MB="5"
